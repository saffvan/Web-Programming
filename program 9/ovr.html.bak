<!DOCTYPE html>
<html>
<head>
<title>Changing Image and Text</title>

<style>
    body {
        margin: 0;
        padding: 0;
        background:#89cff0;
        font-family: Arial, sans-serif;
        text-align: center;
        padding-top: 40px;
    }

    img {
        width: 300px; 
        height: 300px;
        object-fit: cover;
        border: 4px solid #ffffff;
        border-radius: 50%;
      
        
    }


    #p1 {
        font-size: 24px;
        margin-top: 20px;
        font-weight: bold;
        color: #333; 
    }
</style>

<script>
function one() {
    document.getElementById("img").src = "tulip1.jpg";
    document.getElementById("p1").innerHTML = "onmouseover";
    document.getElementById("p1").style.color = "blue";
}

function two() {
    document.getElementById("img").src = "tulip2.jpg";
    document.getElementById("p1").innerHTML = "onmouseout";
    document.getElementById("p1").style.color = "red";
}
</script>

</head>
<body>

<img src="tulip3.jpg" id="img" onmouseover="one()" onmouseout="two()">
<b> <p id = "p1"></p></b>

</body>
</html>
